<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>FrontController</servlet-name>
        <servlet-class>in.ac.iul.mvcproject.controller.FrontController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ImgUpload</servlet-name>
        <servlet-class>in.ac.iul.mvcproject.ImgUpload</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PdfGenerator</servlet-name>
        <servlet-class>in.ac.iul.mvcproject.PdfGenerator</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FrontController</servlet-name>
        <url-pattern>/fc/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ImgUpload</servlet-name>
        <url-pattern>/imgupload</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PdfGenerator</servlet-name>
        <url-pattern>/pdfgenerator</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
